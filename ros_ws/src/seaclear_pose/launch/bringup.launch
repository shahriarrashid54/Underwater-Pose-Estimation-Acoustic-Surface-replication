<?xml version="1.0"?>
<!--
  Common bring-up: empty subsea world, spawn rexrov with the default sensor
  suite (IMU, DVL, pressure, RPT/USBL stub), thruster manager, and a
  velocity-control chain (cmd_vel -> cmd_accel -> thruster forces).
  Per-experiment launch files include this and add the EKF + helper nodes.
-->
<launch>
  <arg name="paused" default="false"/>
  <arg name="gui" default="true"/>
  <arg name="x" default="0"/>
  <arg name="y" default="0"/>
  <arg name="z" default="-3"/>
  <arg name="namespace" default="rexrov"/>
  <arg name="model_name" default="rexrov"/>

  <include file="$(find uuv_gazebo_worlds)/launch/empty_underwater_world.launch">
    <arg name="paused" value="$(arg paused)"/>
    <arg name="gui" value="$(arg gui)"/>
  </include>

  <include file="$(find uuv_descriptions)/launch/upload_rexrov.launch">
    <arg name="x" value="$(arg x)"/>
    <arg name="y" value="$(arg y)"/>
    <arg name="z" value="$(arg z)"/>
    <arg name="namespace" value="$(arg namespace)"/>
    <arg name="mode" value="default"/>
  </include>

  <include file="$(find uuv_thruster_manager)/launch/thruster_manager.launch">
    <arg name="uuv_name" value="$(arg namespace)"/>
    <arg name="model_name" value="$(arg model_name)"/>
  </include>

  <group ns="$(arg namespace)">
    <rosparam file="$(find uuv_control_cascaded_pid)/config/$(arg model_name)/inertial.yaml"
              command="load"/>
    <rosparam file="$(find uuv_control_cascaded_pid)/config/$(arg model_name)/vel_pid_control.yaml"
              command="load"/>

    <node pkg="uuv_control_cascaded_pid" type="AccelerationControl.py"
          name="acceleration_control" output="log">
      <param name="tf_prefix" type="string" value="$(arg namespace)/"/>
    </node>

    <node pkg="uuv_control_cascaded_pid" type="VelocityControl.py"
          name="velocity_control" output="log">
      <remap from="odom" to="/$(arg namespace)/pose_gt"/>
      <remap from="cmd_accel" to="/$(arg namespace)/cmd_accel"/>
    </node>
  </group>
</launch>
