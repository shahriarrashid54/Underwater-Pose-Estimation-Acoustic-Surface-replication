<?xml version="1.0"?>
<!--
  Section V tail: IMU only + 30 s surface fixes (paper Table IV).
-->
<launch>
  <arg name="gui" default="true"/>
  <arg name="duration" default="150.0"/>
  <arg name="surface_period" default="30.0"/>
  <arg name="out_path" default="/root/results/imu_surface_30s.csv"/>
  <arg name="surface_seed" default="0"/>

  <include file="$(find seaclear_pose)/launch/bringup.launch">
    <arg name="gui" value="$(arg gui)"/>
  </include>

  <node pkg="seaclear_pose" type="pressure_to_depth.py" name="pressure_to_depth"
        output="screen"/>

  <node pkg="seaclear_pose" type="surface_feedback_publisher.py"
        name="surface_feedback" output="screen">
    <param name="period" value="$(arg surface_period)"/>
    <param name="seed" value="$(arg surface_seed)"/>
  </node>

  <node pkg="robot_localization" type="ekf_localization_node"
        name="ekf_seaclear" output="screen" clear_params="true">
    <rosparam command="load" file="$(find seaclear_pose)/config/ekf_common.yaml"/>
    <rosparam command="load" file="$(find seaclear_pose)/config/ekf_imu_surface.yaml"/>
  </node>

  <node pkg="seaclear_pose" type="trajectory_publisher.py"
        name="trajectory_publisher" output="screen"/>

  <node pkg="seaclear_pose" type="record_experiment.py"
        name="record_experiment" required="true" output="screen">
    <param name="duration" value="$(arg duration)"/>
    <param name="out_path" value="$(arg out_path)"/>
  </node>
</launch>
